{
  "name": "klartext-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Klartext: the window's top row on hover, for Obsidian",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs --production",
    "test": "vitest run",
    "check": "npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
